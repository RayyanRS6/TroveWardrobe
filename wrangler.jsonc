{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trove-wardrobe",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // Built files (hashed JS/CSS, sw.js, manifest, icons) are served directly;
  // they hold no wardrobe data. Every other path reaches the Worker.
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trove-wardrobe",
      "database_id": "04ec3b01-20d4-460d-9521-d449cf77ffba",
      "migrations_dir": "drizzle"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "B2_STORAGE_LIMIT_BYTES": "9000000000"
  },
  // Local dev reads these from .env; production reads Worker secrets.
  // Account-specific values stay out of this public file.
  "secrets": {
    "required": [
      "APP_PASSWORD_HASH",
      "SESSION_SECRET",
      "B2_ENDPOINT",
      "B2_BUCKET_NAME",
      "B2_APPLICATION_KEY_ID",
      "B2_APPLICATION_KEY"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
