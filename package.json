{
  "name": "trove-wardrobe",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "predev": "npm run db:migrate:local",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:first": "npm run build && node scripts/set-password.mjs --production --deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply trove-wardrobe --local",
    "db:migrate:remote": "wrangler d1 migrations apply trove-wardrobe --remote",
    "cf:types": "wrangler types --include-runtime false",
    "set-password": "node scripts/set-password.mjs",
    "icons": "node scripts/render-icons.mjs",
    "test": "npm run build && node --test \"tests/*.test.mjs\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "lucide-react": "^1.48.0",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "@cloudflare/workers-types": "^5.20260929.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "22.19.19",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.7",
    "react-server-dom-webpack": "^19.3.0",
    "typescript": "5.9.3",
    "vinext": "^1.0.0",
    "vite": "^8.3.1",
    "wrangler": "^4.143.0"
  },
  "type": "module"
}
