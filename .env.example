# Trove environment template.
#
# Copy this file to `.env` and fill in real values. `.env` is ignored by Git;
# this template is public, so it must only ever contain placeholders.

# --- App lock (required) -----------------------------------------------------
# Hash of the single app password (never the password itself).
# Create or change it with: npm run set-password
APP_PASSWORD_HASH=
# Random secret that signs login sessions. `npm run set-password` creates one
# when it is missing. Changing it signs out every device.
SESSION_SECRET=

# --- Backblaze B2 photo storage (required to upload photos) ------------------
# Backblaze > Buckets > your private bucket > "Endpoint",
# e.g. s3.eu-central-003.backblazeb2.com
B2_ENDPOINT=
B2_BUCKET_NAME=
# Backblaze > Application Keys > a key restricted to the bucket above.
# The applicationKey is shown only once, when the key is created.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
